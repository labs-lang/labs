process INITAGENT[attr, l, refresh: any] (id:ID, out var I:Iface, out var p:PC{%-if hasStigmergy-%}, out var L:Lstig{%-endif-%}) is
    access attr, l, refresh;
    var x: Int in
        I := Iface (0);
        p := PC (0);
        {%if hasStigmergy%}L := Lstig (0);{%endif%}
        {%-assign maxi = MAXKEYI | minus: 1-%}
        {%-assign maxl = MAXKEYL | minus: 1-%}
        {% for agent in agents -%}

        {% if forloop.first %}if{% else %}elsif{% endif %} (Nat(id) >= {{agent.start}}) and (Nat(id) < {{agent.end}}) then

        {% for p in agent.pcs -%}
        {% if p.value.size == 1 -%}
        p[{{ p.name }}] := {{ p.value.first }};
        {% else -%}
        x := any Nat where {% for val in p.value -%} (x == {{ val }}){% unless forloop.last %} or {% endunless %}{% endfor %};
        p[{{ p.name }}] := x;
        {% endif -%}{% endfor -%}
        
        {% for i in (0..maxi) -%}
        x := any Int;
        I[{{ i }}] := x;
        {% endfor -%}
        {% if hasStigmergy -%}{% for i in (0..maxl) -%}
        x := any Int;
        L[{{ i }}] := x;
        l(Nat(agent.id), ({{i}} of Nat), x);
        refresh(id, TUPLESTART({{i}}));
        {% endfor -%}{% endif -%}

        {% endfor -%}
        null        
        end if
    end var 
end process

{% if hasEnvironment -%}
{%-assign maxe = MAXKEYE | minus: 1-%}
process ENV [getenv, setenv: any] is
    var x: Int, e:ENV, index:Nat in 
        {% for i in (0..maxe) %}
        x := any Int;
        e[{{ i }}] := x{%- unless forloop.last-%};{%- endunless %}
        {%- endfor -%}
    end var;
    loop
    select
        --index := any Nat where (index < {{ initenv.size }});
        --getenv(index, e[index])
        getenv(e);
        []
        setenv(?index, ?x) where (index < {{ initenv.size }});
        e[index] := x
    end select
    end loop
end process
{%- endif -%}
