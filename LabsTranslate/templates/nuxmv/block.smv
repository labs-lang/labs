{%- assign maxtid = MAXCOMPONENTS | minus: 1 -%}
{%if labs.size > 0-%}
--{%-for l in labs-%}{{l}}{%unless forloop.last%}; {%endunless%}{%-endfor-%}
{%- endif %}

-- Aux variables (nondet values)
{% for a in aux %}
VAR {{a.name}} : integer;
INVAR {{a.name}} >= {{a.start}};
INVAR {{a.name}} < {{a.bound}};
{% if just -%}{%-for tid in (0..maxtid)-%}{%-for j in (a.start..a.bound)-%}
{%unless forloop.last%}JUSTICE tid = {{tid}} & {{a.name}} = {{j}};{%endunless%}
{%-endfor-%}{%-endfor-%}{%-endif %}
{% endfor %}

-- Locals
{%- for a in assignments -%}{% for l in a %}{%- if l.loc == "Local" -%}
DEFINE {{l.name}} := toint({{l.expr | replace: "==", "="}});
{%-endif-%}{%- endfor -%}{%- endfor -%}


-- Pick-variables
{% for l in locals -%}{%- if l.loc contains "Pick" -%}
VAR {{l.name}} : array 0..{{l.size | minus: 1}} of {{l.pickFrom}}..{{l.pickTo | minus: 1}};

INVAR (
    {% for i in (1..l.size) -%}
    {%- unless forloop.first -%}& {%- endunless -%} {{l.name}}[{{i | minus: 1}}] != tid
    {%- endfor -%}
    {%- if l.size > 1 -%}{% for i in (1..l.size) -%}{%-for j in (1..i)-%}
    & {{l.name}}[{{i | minus: 1}}] != {{l.name}})[{{j | minus: 1}}]
    {%- endfor -%}{%- endfor -%}{%-endif-%}
    {%- if l.where != "" -%}
    {% for i in (0..l.size) -%}{%- unless forloop.last -%}
    {%- capture l2 -%}{{l.name}}[{{i}}]{%- endcapture %}
    & {{l.where | replace: "__LABS_link1", "tid" | replace: "__LABS_link2", l2}}
    {% endunless %}{% endfor -%}{%-endif-%}
);

{%-if just-%}{%assign pickMax = l.pickTo | minus: 1%}{%-if l.pickFrom != pickMax-%}
{%- for i in (1..l.size) -%}{%-for tid in (0..maxtid)-%}{%-for j in (l.pickFrom..pickMax)-%}
{%- if l.where != "" -%}
{%-unless j == tid-%}JUSTICE tid = {{tid}} & ({{l.where | replace: "__LABS_link1", tid | replace: "__LABS_link2", j}} -> {{l.name}}[{{i | minus: 1}}] = {{j}});{%-endunless-%}
{%-else-%}
{%-unless j == tid-%}JUSTICE tid = {{tid}} & {{l.name}}[{{i | minus: 1}}] = {{j}};{%-endunless-%}
{%-endif-%}

{% endfor %}

{%endfor%}
{%endfor%}
{%-endif-%}{%-endif-%}

{%-endif-%}{%- endfor -%}

TRANS (
    canProceed
    {%- for item in entrycond -%}
    {% for val in item.value -%}& (pc[tid][{{ item.name }}] = {{ val }})
    {%- endfor -%}{%- endfor -%}
    {% for g in guards -%}& {{ g | replace: "==", "=" }}
    {%- endfor -%}
) -> (
    TRUE
    {%- for a in assignments -%}
    {%- for item in a -%}
    {%- if item.loc == "Local" -%}{%-continue-%}{%- elsif item.loc contains "Pick" -%}{%-continue-%}
    {%- elsif item.loc == "env" -%}
    & next(e[{{item.key}} + {{item.offset}}]) = toint({{item.expr  | replace: "==", "="}})
    {%- elsif item.loc == "attr" -%}
    & next(i[prev_tid][{{item.key}} + {{item.offset}}]) = toint({{item.expr  | replace: "==", "="}})
    {%- elsif item.loc == "lstig" -%}
    & next(lvalue[prev_tid][{{item.key}} + {{item.offset}}]) = toint({{item.expr  | replace: "==", "="}})
    & next(ltstamp[prev_tid][tupleStart[{{item.key}} + {{item.offset}}]]) = now
    & next(hout[prev_tid][tupleStart[{{item.key}} + {{item.offset}}]]) = 1 + hout[tid][tupleStart[{{item.key}} + {{item.offset}}]]
    {%-endif-%}{%- endfor -%}{%- endfor -%}
    {%- if hasEnvironment -%}
    

    -- hold unchanged environment values
    {%- assign erange = (0..MAXKEYE) -%}
    {%- for i in erange -%}{%- unless forloop.last -%}
    {% unless forloop.last -%}& {%endunless%}((TRUE {%- for a in assignments -%}{%- for item in a -%}{%- if item.loc == "env" %} & {{i}} != ({{item.key}} + {{item.offset}}) {%- endif -%}{%- endfor -%}{%- endfor -%}) -> next(e[{{i}}]) = e[{{i}}])
    {%- endunless -%}{%- endfor -%}
    {%- endif -%}
    -- hold unchanged attribute values
    {%- assign irange = (0..MAXKEYI) -%}
    {%- for i in irange -%}{%- unless forloop.last -%}
    {% unless forloop.last -%}& {%endunless%}((TRUE {%- for a in assignments -%}{%- for item in a -%}{%- if item.loc == "attr" %} & {{i}} != ({{item.key}} + {{item.offset}}) {%- endif -%}{%- endfor -%}{%- endfor -%}) -> next(i[prev_tid][{{i}}]) = i[tid][{{i}}])
    {%- endunless -%}{%- endfor -%}

    {%-if hasStigmergy-%}
    -- hold unchanged stigmergy values
    {%- assign lrange = (0..MAXKEYL) -%}
    {%- for i in lrange -%}{%- unless forloop.last -%}
    & ((TRUE {%- for a in assignments -%}{%for item in a%}{%- if item.loc == "lstig" %} & {{i}} != ({{item.key}} + {{item.offset}}) {%- endif -%}{%- endfor -%}{%- endfor -%}) -> next(lvalue[prev_tid][{{i}}]) = lvalue[tid][{{i}}])
    {%- endunless -%}{%- endfor -%}
    -- hold unchanged stigmergy timestamps/hout
    {%- for i in lrange -%}{%- unless forloop.last -%}
    & ((TRUE {%- for a in assignments -%}{%for item in a%}{%- if item.loc == "lstig" %} & tupleStart[{{i}}] != tupleStart[{{item.key}} + {{item.offset}}] {%- endif -%}{%- endfor -%}{%- endfor -%}) -> (next(ltstamp[prev_tid][tupleStart[{{i}}]]) = ltstamp[tid][tupleStart[{{i}}]]) & next(hout[prev_tid][tupleStart[{{i}}]]) = hout[tid][tupleStart[{{i}}]]))
    {%- endunless -%}{%- endfor -%}
    {%- endif -%}

    -- if a variable is a tuplestart & has been read, update hin, otherwise keep it
    -- qrykeys: {%- for k in qrykeys %} {{k}} {%endfor%}
    {%- for i in qrykeys %}
    & next(hin[prev_tid][tupleStart[{{i}}]]))
    {%- endfor -%}
    {%- for i in lrange -%}{%- unless forloop.last -%}
    & (TRUE {% for j in qrykeys %} & tupleStart[{{i}}] != tupleStart[{{j}}]{%endfor%}) -> next(hin[prev_tid][tupleStart[{{i}}]]) = next(hin[prev_tid][tupleStart[{{i}}]])
    {%- endunless -%}{%- endfor -%}

    -- exitcond
    {%- for item in exitcond -%}
    & next(pc[prev_tid][{{item.name}}]) in { {% for val in item.value -%}{{val}}{%-unless forloop.last -%},{%- endunless -%}{%- endfor %} }
    {%- endfor -%}
);
