{%for a in aux%}
VAR {{a.name}} : integer;
INVAR {{a.name}} >= {{a.start}};
INVAR {{a.name}} < {{a.bound}};
{%endfor%}

--{{labs}}
TRANS (
    __turn = step
    {%- for item in entrycond -%}
    {% for val in item.value -%}& (pc[tid][{{ item.name }}] = {{ val }})
    {%- endfor -%}{%- endfor -%}
    {% for g in guards -%}& {{ g | replace: "==", "=" }}
    {%- endfor -%}
) -> (
    TRUE
    -- TODO assign
    {%- for item in assignments -%}
    & next({% if item.loc == "env" -%}e{%- elsif item.loc == "attr"-%}i[tid]{%- endif -%}[{{item.key}} + {{item.offset}}]) = toint({{item.expr  | replace: "==", "="}})
    {%- endfor -%}
    {%- if hasEnvironment -%}
    -- hold unchanged environment values
    {%- assign erange = (0..MAXKEYE) -%}
    {%- for i in erange -%}{%- unless forloop.last -%}
    {% unless forloop.last -%}& {%endunless%}((TRUE {%- for item in assignments -%}{%- if item.loc == "env" %} & {{i}} != ({{item.key}} + {{item.offset}}) {%- endif -%}{%- endfor -%}) -> next(e[{{i}}]) = e[{{i}}])
    {%- endunless -%}{%- endfor -%}
    {%- endif -%}
    -- hold unchanged attribute values
    {%- assign irange = (0..MAXKEYI) -%}
    {%- for i in irange -%}{%- unless forloop.last -%}
    {% unless forloop.last -%}& {%endunless%}((TRUE {%- for item in assignments -%}{%- if item.loc == "attr" %} & {{i}} != ({{item.key}} + {{item.offset}}) {%- endif -%}{%- endfor -%}) -> next(i[tid][{{i}}]) = i[tid][{{i}}])
    {%- endunless -%}{%- endfor -%}

    -- exitcond
    {%- for item in exitcond -%}
    & next(pc[tid][{{item.name}}]) in { {% for val in item.value -%}{{val}}{%-unless forloop.last -%},{%- endunless -%}{%- endfor %} }
    {%- endfor -%}
);
