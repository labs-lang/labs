
{%-assign maxi = MAXKEYI | minus: 1-%}
{%-assign maxl = MAXKEYL | minus: 1-%}
process INITAGENT[attrGate, l: any] (in out agent:Agent{%-if hasStigmergy-%}, in out m:Matrix{%-endif-%}) is
    var I:Iface, x: Int, p:PC{%-if hasStigmergy-%}, L:Lstig{%- endif %} in
        I := agent.I;
        {% if hasStigmergy %}L := agent.L;{%- endif %}
        p := agent.pc;

        {% for agent in agents -%}
        {% unless forloop.first %}els{% endunless %}if (Nat(agent.id) >= {{agent.start}}) and (Nat(agent.id) < {{agent.end}}) then

        {% for p in agent.pcs -%}
        {% if p.value.size == 1 -%}
        p[{{ p.name }}] := {{ p.value.first }};
        {% else -%}
        x := any Nat where {% for val in p.value -%} (x == {{ val }}){% unless forloop.last %} or {% endunless %}{% endfor %};
        p[{{ p.name }}] := x;
        {% endif -%}{% endfor -%}

        {% for i in (0..maxi) -%}
        x := any Int;
        I[{{ i }}] := x;
        attrGate(Nat(agent.id), ({{i}} of Nat), x);
        {% endfor -%}
        {% for i in (0..maxl) -%}
        x := any Int;
        L[{{ i }}] := x;
        l(Nat(agent.id), ({{ i }} of Nat), x);
        eval refresh(!?m, {{ i }}, Nat(agent.Id));
        {% endfor -%}
        {% endfor -%}
        
        null
        end if;
        agent := agent.{I -> I{%-if hasStigmergy-%}, L -> L{%- endif -%}, pc -> p}
    end var 
end process

{% if hasEnvironment -%}
{%-assign maxe = MAXKEYE | minus: 1-%}
process INITENV(in out e: Env) is
    var x: Int in 
        {% for i in (0..maxe) %}
        x := any Int;
        e[{{ i }}] := x;
        {%- endfor -%}
        null
    end var
end process
{%- endif -%}
